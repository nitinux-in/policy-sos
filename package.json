{
  "name": "ditto-insurance-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite --host\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:engine": "tsx scripts/check-engine.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
